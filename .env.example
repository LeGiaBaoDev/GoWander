# Copy to .env for local development. Never commit .env.
# Every value below is a placeholder. No service reads these yet;
# names are the proposed contract for Docker Compose and the Go API.

APP_ENV=local
LOG_LEVEL=info

# Go API
API_HTTP_ADDR=:8081

# PostgreSQL + PostGIS (local container)
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=gowander
POSTGRES_USER=gowander_app
POSTGRES_PASSWORD=change-me-local-only

# OpenTripPlanner
OTP_BASE_URL=http://localhost:8080
OTP_REQUEST_TIMEOUT_SECONDS=10
