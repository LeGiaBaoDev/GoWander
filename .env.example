# Copy to .env for local development. Never commit .env.
# Every password below is a placeholder; generate your own (for example: openssl rand -hex 24).

# Go API (backend/README.md, ADR-027)
HTTP_ADDR=127.0.0.1:8090
OTP_URL=http://127.0.0.1:8088
# Graph toàn TP.HCM có xe buýt (RD-0, ADR-032): OTP_URL=http://127.0.0.1:8089
OTP_TIMEOUT=8s
ROUTING_DATA_STATUS=ASSUMED
# Self-hosted Photon geocoder (infrastructure/photon/README.md)
PHOTON_URL=http://127.0.0.1:2322
# Runtime role: SELECT only (ADR-028). Production must use sslmode=verify-full.
DATABASE_URL=postgres://gowander_app:change-me-app@127.0.0.1:5432/gowander?sslmode=disable
# Migration and seed role: owns schema gowander
MIGRATE_DATABASE_URL=postgres://gowander_owner:change-me-owner@127.0.0.1:5432/gowander?sslmode=disable

# PostgreSQL + PostGIS container (infrastructure/postgres/db.sh, ADR-028)
POSTGRES_DB=gowander
POSTGRES_PORT=5432
POSTGRES_SUPERUSER_PASSWORD=change-me-superuser
GOWANDER_OWNER_PASSWORD=change-me-owner
GOWANDER_APP_PASSWORD=change-me-app

# Ảnh đường phố cho "Xem trước tuyến đường" (NAV-1, ADR-033). Token client tạo ở https://www.mapillary.com/dashboard/developers ; để trống = tắt tính năng
MAPILLARY_TOKEN=

# Admin (M07, ADR-037). The Admin pages use their own database role; the public API stays read-only.
GOWANDER_ADMIN_PASSWORD=
ADMIN_DATABASE_URL=postgres://gowander_admin:CHANGE_ME@127.0.0.1:5432/gowander?sslmode=disable
# Google OAuth client (Web application). Redirect URI: <ADMIN_BASE_URL>/admin/auth/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Public address of the API as the browser sees it (builds the OAuth redirect URI).
ADMIN_BASE_URL=http://localhost:8090
# Email that becomes the first SYSTEM_ADMIN while nobody has a role yet. Private: keep it in .env only.
ADMIN_BOOTSTRAP_EMAIL=

