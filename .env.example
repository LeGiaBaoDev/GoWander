# Copy to .env for local development. Never commit .env.
# Every password below is a placeholder; generate your own (for example: openssl rand -hex 24).

# Go API (backend/README.md, ADR-027)
HTTP_ADDR=:8090
OTP_URL=http://127.0.0.1:8088
OTP_TIMEOUT=8s
ROUTING_DATA_STATUS=ASSUMED
# Runtime role: SELECT only (ADR-028). Production must use sslmode=verify-full.
DATABASE_URL=postgres://gowander_app:change-me-app@127.0.0.1:5432/gowander?sslmode=disable
# Migration and seed role: owns schema gowander
MIGRATE_DATABASE_URL=postgres://gowander_owner:change-me-owner@127.0.0.1:5432/gowander?sslmode=disable

# PostgreSQL + PostGIS container (infrastructure/postgres/db.sh, ADR-028)
POSTGRES_DB=gowander
POSTGRES_PORT=5432
POSTGRES_SUPERUSER_PASSWORD=change-me-superuser
GOWANDER_OWNER_PASSWORD=change-me-owner
GOWANDER_APP_PASSWORD=change-me-app
